{
  "name": "@kanutus/mcp",
  "version": "0.3.7",
  "description": "Kanutus MCP server: rooms with live translation, meetings, booking, voices and usage for Claude, ChatGPT and your own agents.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://docs.kanutus.com/mcp",
  "repository": { "type": "git", "url": "git+https://github.com/kanutus/mcp.git" },
  "keywords": ["mcp", "model-context-protocol", "kanutus", "translation", "meetings"],
  "bin": { "kanutus-mcp": "dist/stdio.js" },
  "main": "dist/index.js",
  "exports": { ".": "./dist/index.js" },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/http.ts",
    "start:http": "tsx --env-file-if-exists=.env src/http.ts",
    "stdio": "tsx src/stdio.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "jose": "^6.2.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3"
  }
}
